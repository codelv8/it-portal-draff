{
  "$schemaVersion": "1.0",
  "name": "IT Portal Aurora Coral UI Contract",
  "version": "3.1.0",
  "ownerDecisionDate": "2026-10-25",
  "reference": "DESIGN.md",
  "userVisualConfigFile": "design-config.json",
  "sourceOfTruthCss": "assets/css/styles.css",
  "locked": {
    "visualDirection": "Aurora Gradient reference",
    "layout": "portal",
    "surface": "glass",
    "palette": "coral",
    "mode": "dark",
    "cornerRadius": 32,
    "fontFamily": "LINE Seed Sans TH",
    "mascotEnabled": true
  },
  "cssVariables": {
    "--bg": "#fbf8f8",
    "--ink": "#332d38",
    "--ink-soft": "#5d5664",
    "--muted": "#756776",
    "--coral": "#f46f75",
    "--coral-dark": "#d54e5c",
    "--coral-soft": "#fff1ee",
    "--peach": "#ffd9bd",
    "--lavender": "#eee0ff",
    "--mint": "#d9f6e9",
    "--radius": "32px",
    "--radius-small": "19px",
    "--surface": "rgba(255,255,255,.76)",
    "--surface-strong": "rgba(255,255,255,.92)",
    "--surface-muted": "rgba(255,255,255,.52)",
    "--action-fill": "#be4355",
    "--action-hover": "#a9364a",
    "--link-ink": "#be4355"
  },
  "requiredCssPatterns": [
    ".app-shell",
    ".sidebar",
    ".workspace",
    ".topbar",
    ".glass",
    ".card",
    ".btn-primary",
    ".page-heading",
    ".badge",
    ".modal-backdrop",
    ".kanban-board",
    ".gantt",
    "prefers-reduced-motion",
    ".theme-choice",
    ".theme-option",
    ".theme-preview",
    "html:not([data-theme=\"light\"])"
  ],
  "htmlPages": [
    "index.html",
    "duty.html",
    "portal.html",
    "announcements.html",
    "guide.html",
    "e-learning.html",
    "hait.html",
    "digital-policy.html",
    "admin/index.html",
    "admin/login.html",
    "admin/my-work.html",
    "admin/task-detail.html",
    "admin/team-board.html",
    "admin/projects.html",
    "admin/project-detail.html",
    "admin/roadmap.html",
    "admin/kpi.html",
    "admin/reports.html",
    "admin/compliance.html",
    "admin/service-desk.html",
    "admin/notifications.html",
    "admin/people.html",
    "admin/activity.html",
    "admin/settings.html"
  ],
  "forbiddenExternalUiFrameworks": [
    "bootstrap",
    "tailwind",
    "react",
    "vue",
    "angular",
    "materialize",
    "bulma",
    "cdn.jsdelivr.net",
    "unpkg.com"
  ],
  "supportedModes": [
    "dark",
    "light"
  ],
  "themePreferenceKey": "it-portal-theme-v1",
  "themeVariants": {
    "dark": {
      "selector": "html:not([data-theme=\"light\"])",
      "cssVariables": {
        "--bg": "#15131f",
        "--ink": "#f7edf5",
        "--ink-soft": "#dfd2df",
        "--muted": "#c6b7c5",
        "--coral": "#ffa0a6",
        "--coral-dark": "#ffabb2",
        "--surface": "rgba(37,33,51,.80)",
        "--surface-strong": "rgba(51,44,64,.95)",
        "--action-fill": "#b7435d",
        "--action-hover": "#a33853",
        "--link-ink": "#ffabb2"
      }
    }
  },
